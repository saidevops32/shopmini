# Copy to env.sh, fill in, then: source env.sh   (env.sh is git-ignored)
export PATH="$HOME/bin:$PATH"
export PROJECT=shopmini
export GH_USER=YOUR_GITHUB_USER
export GH_REPO=shopmini
export LOCATION=centralindia
export RG=rg-shopmini-dev
export AKS=aks-shopmini-dev
# globally unique names (suffix set once during setup)
export ACR=acrshopminiSUFFIX
export KV=kv-shopmini-SUFFIX
export MYSQL_SERVER=mysql-shopmini-SUFFIX
export PG_SERVER=pg-shopmini-SUFFIX
export MYSQL_USER=shopadmin
export PG_USER=shopadmin
# NO passwords here. DB passwords are generated in Phase 1 and stored
# only in Azure Key Vault.
