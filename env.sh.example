# Copy to env.sh, replace the SUFFIX and YOUR_GITHUB_USER values, then: source env.sh
# env.sh is git-ignored. NEVER put passwords in this file.
# Order matters: derived values (HOST, NODE_RG) must come after what they use.
export PATH="$HOME/bin:$PATH"

# project
export PROJECT=shopmini
export GH_USER=YOUR_GITHUB_USER
export REPO_NAME=shopmini

# region (databases and AKS share one region; Key Vault may differ)
export LOCATION=southindia
export DB_LOCATION=southindia

# azure resources (SUFFIX = the same 6-hex value you chose at setup)
export RG=rg-shopmini-dev
export AKS=aks-shopmini-dev
export ACR=acrshopminiSUFFIX
export KV=kv-shopmini-SUFFIX
export PG_SERVER=pg-shopmini-SUFFIX-southindia
export MYSQL_SERVER=mysql-shopmini-SUFFIX-southindia
export PG_USER=shopadmin
export MYSQL_USER=shopadmin

# cluster sizing
export NODE_SIZE=Standard_D2s_v4
export NODE_COUNT=1

# derived (keep these LAST)
export PG_HOST=${PG_SERVER}.postgres.database.azure.com
export MYSQL_HOST=${MYSQL_SERVER}.mysql.database.azure.com
export NODE_RG=MC_${RG}_${AKS}_${LOCATION}

# DB passwords live ONLY in Azure Key Vault: source scripts/load-db-secrets.sh
